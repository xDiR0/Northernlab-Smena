%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2fc0df0c9e9cdaac818feb7aae4e587e, type: 3}
  m_Name: StationBalance
  m_EditorClassIdentifier: 
  shiftSeconds: 225
  fuelCapacity: 110
  fuelPerSecond: 0.13
  coldPerSecond: 0.24
  warmthPerSecond: 0.45
  generatorPower: 5
  boostPower: 8
  demand: 02000000010000000300000002000000
  sosSeconds: 85
  repairSeconds: 3
  warningSeconds: 9
  shifts:
  - title: "Прибытие"
    briefing: "Предыдущая команда не сдала журнал. Возьмите канистру, заправьте генератор. Затем доставьте предохранитель из мастерской к щиту. ЛКМ по объекту прокладывает маршрут. Для предметов нужна свободная рука."
    task: "Запустите генератор. Установите предохранитель. К концу смены вернитесь к обогревателю."
    record: "Последняя запись: «Не отвечать на вызовы лифта после полуночи»."
    parts: 3
    heatingMultiplier: 1
  - title: "Второй сотрудник"
    briefing: "Архив открыт. Заберите ящик запчастей и журнал. Для радио нужны инструмент, предохранитель и 2 детали за каждый из трёх этапов ремонта. Инструмент после работы можно положить кнопкой внизу."
    task: "Исследуйте архив. Начните ремонт передатчика."
    record: "Список экспедиции: восемь фамилий. Девятая вписана тем же почерком восемь раз."
    parts: 4
    heatingMultiplier: 1
  - title: "Белая стена"
    briefing: "Метель усилилась. Отопление требует дополнительный киловатт. В середине смены ожидается остановка генератора. Принесите инструмент заранее."
    task: "Переживите метель и почините генератор."
    record: "Метеосводка: ветер дует из шахты. Прибор проверен дважды."
    parts: 3
    heatingMultiplier: 1.6
  - title: "Здоровый образец"
    briefing: "Биолаборатория разблокирована. Без биосдерживания растёт опасность. Сеть тянет либо отопление с биосдерживанием, либо отопление, свет и радио. Переключайте питание у щита."
    task: "Изучите лабораторию. Следите за температурой и биосдерживанием."
    record: "Протокол: образец реагирует на шум. Свет для него необязателен."
    parts: 3
    heatingMultiplier: 1
  - title: "Кто-то идёт"
    briefing: "При стуке закройте заслонку у лифта. Фальшфейеры на нижней площадке отпугивают образец. Он слышит форсированный генератор. Не задерживайтесь внизу."
    task: "Подготовьте заслонку. Сохраните запас топлива."
    record: "Охрана: три удара перед входом. Он всё ещё соблюдает инструкцию."
    parts: 3
    heatingMultiplier: 1
  - title: "Последние детали"
    briefing: "Заберите детали со склада. Завершите три этапа ремонта передатчика. Генератор потребует ремонта. Не расходуйте все детали на улучшения."
    task: "Передатчик 3/3. Заготовьте топливо для последней смены."
    record: "Диспетчер запрашивает эвакуацию одного человека. Второй сотрудник отказался подниматься."
    parts: 4
    heatingMultiplier: 1
  - title: "Смена не окончена"
    briefing: "Окно связи открыто. Закройте заслонку, заправьте генератор. Включите отопление и радио: свет можно оставить аварийным. Настройте частоту по максимуму сигнала и держите панель открытой для SOS. Прерывание сохраняет прогресс."
    task: "Передайте SOS и удержите станцию до конца смены."
    record: "Исходящая радиограмма: «Мы здесь одни». В журнале исправлено: «Я»."
    parts: 3
    heatingMultiplier: 1
